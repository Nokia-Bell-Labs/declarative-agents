<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{.Title}}</title>
<style>
body { font-family: system-ui, sans-serif; margin: 1rem; color: #1f2937; }
html.embed body { margin: 0; }
html.embed h1 { display: none; }
.controls { display: flex; flex-wrap: wrap; gap: 8px 16px; align-items: center; margin: 0 0 8px; font-size: 14px; }
.controls select { font: inherit; }
table { border-collapse: collapse; font-size: 13px; width: 100%; }
th, td { text-align: left; padding: 5px 10px; border-bottom: 1px solid #e5e7eb; white-space: nowrap; }
td.title, td.story, td.epic { white-space: normal; }
th { color: #6b7280; font-weight: 600; border-bottom: 1px solid #d1d5db; }
a { color: #2563eb; text-decoration: none; }
a:hover { text-decoration: underline; }
.state { display: inline-block; padding: 1px 8px; border-radius: 9px; font-size: 12px; }
.state.open { background: #dbeafe; color: #1d4ed8; }
.state.closed { background: #dcfce7; color: #15803d; }
#count { color: #6b7280; font-size: 13px; }
#none { color: #6b7280; }
</style>
<script>if (/[?&]embed=1(&|$)/.test(location.search)) document.documentElement.className = "embed";</script>
</head>
<body>
<!-- Generated by the site skill's backlog word from the timeline facts. Regenerate it; do not edit it. -->
<h1>{{.Title}}</h1>
<div class="controls">
  <label>Repository <select id="repo"><option value="">all</option></select></label>
  <label>State <select id="state"><option value="">all</option><option value="open">open</option><option value="closed">closed</option></select></label>
  <label>Who <select id="who"><option value="">anyone</option></select></label>
  <span id="count"></span>
</div>
<p id="none" hidden>No recorded issue matches. A story records its issues once scrum-master backlog record runs in its scrum repository (srd045 R4.4).</p>
<table id="rows" hidden>
  <thead><tr><th>issue</th><th>title</th><th>state</th><th>who</th><th>opened</th><th>closed</th><th>days</th><th>projected</th><th>story</th><th>epic</th></tr></thead>
  <tbody></tbody>
</table>
<script type="application/json" id="backlog-data">{{.Data}}</script>
<script>
(function () {
  // The stories' issues records, filterable in place (srd048 R10): the
  // rows are inlined, the page makes no request, and a planning item
  // opens its page in the site, in the top window, so the embedded table
  // navigates the app.
  var D = JSON.parse(document.getElementById("backlog-data").textContent);
  var query = new URLSearchParams(location.search);
  var state = { repo: query.get("repo") || "", state: query.get("state") || "", who: query.get("who") || "" };
  var repos = {}, who = {};
  D.rows.forEach(function (r) {
    repos[r.repository] = true;
    (r.who || []).forEach(function (w) { who[w] = true; });
  });
  function fill(id, values) {
    var sel = document.getElementById(id);
    Object.keys(values).sort().forEach(function (v) {
      var o = document.createElement("option");
      o.value = v; o.textContent = v;
      sel.appendChild(o);
    });
    if (!values[state[id]]) state[id] = "";
    sel.value = state[id];
  }
  fill("repo", repos);
  fill("who", who);
  if (state.state !== "open" && state.state !== "closed") state.state = "";
  document.getElementById("state").value = state.state;
  function esc(s) { return String(s == null ? "" : s).replace(/[&<>"]/g, function (c) { return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]; }); }
  function page(id) { return esc(new URL("../#/hierarchy/" + id, location.href).href); }
  function draw() {
    var body = document.querySelector("#rows tbody");
    body.innerHTML = "";
    var kept = D.rows.filter(function (r) {
      if (state.repo && r.repository !== state.repo) return false;
      if (state.state && r.state !== state.state) return false;
      if (state.who && (r.who || []).indexOf(state.who) < 0) return false;
      return true;
    });
    kept.forEach(function (r) {
      var tr = document.createElement("tr");
      var issue = r.url ? '<a href="' + esc(r.url) + '" target="_blank" rel="noopener">' + esc(r.ref) + "</a>" : esc(r.ref);
      var story = '<a href="' + page(r.story) + '" target="_top">' + esc(r.story_title) + "</a>";
      var epic = r.epic ? '<a href="' + page(r.epic) + '" target="_top">' + esc(r.epic_title) + "</a>" : "";
      tr.innerHTML = "<td>" + issue + "</td><td class=\"title\">" + esc(r.title) + "</td>" +
        '<td><span class="state ' + esc(r.state) + '">' + esc(r.state) + "</span></td>" +
        "<td>" + esc((r.who || []).join(", ")) + "</td><td>" + esc(r.opened) + "</td><td>" + esc(r.closed) + "</td>" +
        "<td>" + esc(r.days) + "</td><td>" + esc(r.projected) + "</td>" +
        '<td class="story">' + story + '</td><td class="epic">' + epic + "</td>";
      body.appendChild(tr);
    });
    document.getElementById("rows").hidden = kept.length === 0;
    document.getElementById("none").hidden = kept.length > 0;
    document.getElementById("count").textContent = kept.length + " of " + D.rows.length + " issues";
    // Embedded, the table tells the page holding it how tall it is, so
    // the page sizes its frame and the reader scrolls once (GH-136).
    if (window.parent !== window) {
      window.parent.postMessage({ timelineHeight: document.documentElement.scrollHeight }, "*");
    }
  }
  ["repo", "state", "who"].forEach(function (id) {
    document.getElementById(id).addEventListener("change", function (e) { state[id] = e.target.value; draw(); });
  });
  draw();
})();
</script>
</body>
</html>
