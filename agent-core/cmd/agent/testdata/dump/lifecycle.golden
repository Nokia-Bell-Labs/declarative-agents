dump_version: 1
profile:
  name: core-lifecycle-approval
  machine: <agent-core>/testdata/integration/profiles/lifecycle/machine.yaml
  tools:
    - <agent-core>/testdata/integration/profiles/lifecycle/tools.yaml
  tool_declarations:
    - <agent-core>/tools/builtin/lifecycle/exit-agent.yaml
    - <agent-core>/tools/builtin/suspend.yaml
    - <agent-core>/tools/builtin/done.yaml
machine:
  name: core-lifecycle-approval
  purpose: Prove suspend and resume through Agent Core lifecycle ports.
  invariants:
    - Suspend is a machine action, not a hidden CLI branch.
    - Approved resume continues through an explicit machine signal.
    - Rejected resume stops without running the approved path.
  configuration:
    machine: machine.yaml
    tools: tools.yaml
  initial_state: Idle
  resume_signal: Approved
  states:
    - name: Idle
      meaning: Initial state before the approval gate.
    - name: AwaitingApproval
      meaning: The first run suspended and waits for an operator signal.
    - name: ApplyingApproval
      meaning: The approved path is running after resume.
    - name: Succeeded
      meaning: Terminal. The approved path completed.
      run_status: succeeded
    - name: Rejected
      meaning: Terminal. The operator rejected the risky action.
      run_status: failed
    - name: Failed
      meaning: Terminal. Suspend or resume failed.
      run_status: failed
  terminal_states:
    - Succeeded
    - Rejected
    - Failed
  signals:
    - name: Seed
      trigger: Loop initialization.
    - name: AwaitApproval
      trigger: suspend requested an approval checkpoint.
    - name: Approved
      trigger: Operator approved the suspended action during resume.
    - name: Rejected
      trigger: Operator rejected the suspended action during resume.
    - name: TaskCompleted
      trigger: done completed the approved path.
    - name: CommandError
      trigger: Runtime or command infrastructure failed.
  transitions:
    - state: Idle
      signal: Seed
      next: AwaitingApproval
      action: suspend
    - state: AwaitingApproval
      signal: AwaitApproval
      next: AwaitingApproval
    - state: AwaitingApproval
      signal: Approved
      next: ApplyingApproval
      action: done
    - state: AwaitingApproval
      signal: Rejected
      next: Rejected
    - state: AwaitingApproval
      signal: CommandError
      next: Failed
    - state: ApplyingApproval
      signal: TaskCompleted
      next: Succeeded
  budget:
    max_iterations: 5
    command_timeout: 1m
types:
  - ref: builtin-types-core.AnyValue
    description: Any JSON value accepted by the schema configured on the word.
    schema:
      description: The runtime value is any JSON value accepted by the configured schema.
  - ref: builtin-types-core.CommandSummary
    description: The message and outcome signal a command word publishes.
    schema:
      properties:
        message:
          type: string
        signal:
          type: string
      required:
        - message
      type: object
  - ref: builtin-types-core.ExecResult
    description: The exit status and captured output of one child process an exec word ran.
    schema:
      properties:
        exit_code:
          type: integer
        output:
          type: string
      required:
        - exit_code
        - output
      type: object
  - ref: builtin-types-core.NoParameters
    description: The empty parameter object of a word whose input arrives through config selectors.
    schema:
      properties: {}
      type: object
  - ref: builtin-types-core.Text
    description: Plain text a word publishes as its whole result.
    schema:
      type: string
instantiations:
  - kind: machine
    fragment: <agent-core>/tools/machines/lifecycle-approval-machine-template.yaml
    args:
      machine: machine.yaml
      tools: tools.yaml
    produces:
      - machine/core-lifecycle-approval
tools:
  - name: done
    type: builtin
    category: word
    description: Signal that the generation task is complete.
    problem: Signal that the generation task is complete.
    goals:
      - Signal that the generation task is complete.
    requirements:
      input:
        - done declares no input type
      output:
        - done takes its output as builtin-types-core.CommandSummary
      errors:
        - done emits CommandError when it cannot produce its declared output
    non_goals:
      - Behavior outside done, which its signature states in full
    output:
      description: done command result summary.
      schema:
        properties:
          message:
            type: string
          signal:
            type: string
        required:
          - message
        type: object
    side_effects:
      - kind: none
        state: read_only
        description: done computes a value and mutates nothing
    reversibility:
      classification: reversible
    undo:
      strategy: noop
      description: done mutates nothing, so undo does nothing
    errors:
      - signal: CommandError
        condition: required input, configuration, or runtime state is invalid
        message_shape: 'done: <error>'
        state_after_failure: no additional workflow step is executed by this tool
    init: done
    emits:
      - TaskCompleted
    signature:
      output: builtin-types-core.CommandSummary
      emits:
        - TaskCompleted
    visibility: internal
  - name: suspend
    type: builtin
    category: boundary
    contract: migrated
    description: Suspend the run at an approval gate. The loop persists a checkpoint through the Checkpoint port when a persistent backend (--dolt-dsn) is configured.
    problem: Suspend the run at an approval gate. The loop persists a checkpoint through the Checkpoint port when a persistent backend (--dolt-dsn) is configured.
    goals:
      - Suspend the run at an approval gate. The loop persists a checkpoint through the Checkpoint port when a persistent backend (--dolt-dsn) is configured.
    requirements:
      input:
        - suspend declares no input type
      output:
        - suspend declares no output type
      errors:
        - suspend emits CommandError when it cannot produce its declared output
    non_goals:
      - Behavior outside suspend, which its signature states in full
    output:
      description: The configured or default reason presented at the approval boundary; the opaque receipt carries rollback compensation context.
      schema:
        type: string
    side_effects:
      - kind: state_mutation
        target: lifecycle_checkpoint
        state: suspended
        description: Requests suspension; the loop persists a checkpoint through the Checkpoint port when a persistent backend is configured.
      - kind: human_boundary
        target: operator_approval
        description: Hands control to an operator approval decision before resume.
    reversibility:
      classification: compensatable
    undo:
      strategy: compensating_action
      description: Resume with Approved, reject with Rejected, or roll back to an earlier checkpoint.
      payload: suspend_receipt
      captures:
        - label
        - reason
        - checkpoint_required
        - checkpoint_configured
        - checkpoint_reference_context
      requires:
        - operator_decision
        - resume_signal_or_rollback_target
    errors:
      - signal: CommandError
        condition: require_checkpoint is true but the Checkpoint port is nil or the no-op backend
        message_shape: suspend requires a persistent checkpoint backend for checkpoint persistence
        state_after_failure: the run is not suspended and no approval handoff occurs
    init: suspend
    config:
      label: approval
      reason: awaiting approval
      require_checkpoint: false
    emits:
      - AwaitApproval
      - CommandError
    signature:
      emits:
        - AwaitApproval
        - CommandError
    visibility: internal
rest: {}
