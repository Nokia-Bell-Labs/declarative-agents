dump_version: 1
profile:
  name: library-two
  machine: <agent-core>/testdata/integration/profiles/library-two/machine.yaml
  tools:
    - <agent-core>/testdata/integration/profiles/library-two/tools.yaml
  tool_declarations:
    - <agent-core>/testdata/integration/profiles/library-two/declarations.yaml
  libraries:
    shared: <agent-core>/testdata/integration/library
machine:
  name: library-two
  purpose: Say the shared library's word once and finish.
  initial_state: Idle
  states:
    - name: Idle
      meaning: Initial state.
    - name: Saying
      meaning: Saying the shared word.
    - name: Succeeded
      meaning: Terminal success.
      run_status: succeeded
    - name: Failed
      meaning: Terminal failure.
      run_status: failed
  terminal_states:
    - Succeeded
    - Failed
  signals:
    - name: Seed
      trigger: Loop initialization.
    - name: Done
      trigger: The word finished.
    - name: CommandError
      trigger: Runtime failure.
  transitions:
    - state: Idle
      signal: Seed
      next: Saying
      action: say_shared
    - state: Saying
      signal: Done
      next: Succeeded
    - state: Saying
      signal: CommandError
      next: Failed
  budget:
    max_iterations: 3
    command_timeout: 1m
types:
  - ref: shared-types.Text
    description: Plain text the shared library's word publishes.
    schema:
      type: string
tools:
  - name: say_shared
    type: builtin
    category: word
    description: Finish with the shared library's word.
    problem: Finish with the shared library's word.
    goals:
      - Finish with the shared library's word.
    requirements:
      input:
        - say_shared declares no input type
      output:
        - say_shared takes its output as shared-types.Text
      errors:
        - say_shared emits CommandError when it cannot produce its declared output
    non_goals:
      - Behavior outside say_shared, which its signature states in full
    output:
      schema:
        type: string
    side_effects:
      - kind: none
        state: read_only
        description: say_shared computes a value and mutates nothing
    reversibility:
      classification: reversible
    undo:
      strategy: noop
      description: say_shared mutates nothing, so undo does nothing
    errors:
      - signal: CommandError
        condition: required input, configuration, or runtime state is invalid
        message_shape: 'say_shared: <error>'
        state_after_failure: no additional workflow step is executed by this tool
    init: done
    emits:
      - Done
    signature:
      output: shared-types.Text
      emits:
        - Done
rest: {}
files:
  - path: <agent-core>/testdata/integration/library/types/shared-types.yaml
    sha256: e6963f40349787587cc4353592121d3594bbd1ab5acd938d40c64d92caf6576f
    root: shared
  - path: <agent-core>/testdata/integration/library/units/shared-words.yaml
    sha256: 73666358f741b0cc0db23b2010e603f94b79c14bea2d30ff722f3d4a97b304b2
    root: shared
  - path: <agent-core>/testdata/integration/profiles/library-two/declarations.yaml
    sha256: 67b774608e58016eece4d2cd46a9a19878ef58f119153b354f4d1d23b0756d21
  - path: <agent-core>/testdata/integration/profiles/library-two/machine.yaml
    sha256: 4392f04c85164b09ca8c44d5e6c18fb63501945208db67a23b9f794f105eb1c0
  - path: <agent-core>/testdata/integration/profiles/library-two/profile.yaml
    sha256: 61cffbc5ec2df0b712594453952a28ceda28f6d26a9d22dd9225c706b1ea8016
