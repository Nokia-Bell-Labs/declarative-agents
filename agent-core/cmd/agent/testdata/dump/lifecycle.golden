  - path: <agent-core>/testdata/integration/profiles/lifecycle/machine.yaml
    sha256: 4a0eb71a3489108416150f53ea49e8d85b91c0dea22af8b4163dfadff215d4e0
  - path: <agent-core>/testdata/integration/profiles/lifecycle/profile.yaml
    sha256: 83ef6c0f58c750bc0a75a52e8730501298bba657ae386a5b077478fa821e0830
  - path: <agent-core>/testdata/integration/profiles/lifecycle/tools.yaml
    sha256: a3be02c2c7c96a9b5fca8dcea06f9f782f77ec97d80ffc74fc6281295904d7d2
  - path: <agent-core>/tools/builtin/done.yaml
    sha256: 8980b6319e71b384508387ef49c7a144702c03368e4bb0dd68abd7f25025dadc
  - path: <agent-core>/tools/builtin/lifecycle/exit-agent.yaml
    sha256: 81938b2d96dd9be01aaab2360b2e4ce7c11a22690081cf4a9e34cbabb402cf25
