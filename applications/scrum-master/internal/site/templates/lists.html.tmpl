<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{.Title}}</title>
<style>
body { font-family: system-ui, sans-serif; margin: 1rem; color: #1f2937; }
html.embed body { margin: 0; }
html.embed h1 { display: none; }
.controls { display: flex; flex-wrap: wrap; gap: 8px 16px; align-items: center; margin: 0 0 10px; font-size: 14px; }
.controls select { font: inherit; max-width: 16em; }
a { color: #2563eb; text-decoration: none; }
a:hover { text-decoration: underline; }
.board { display: flex; gap: 12px; align-items: flex-start; }
.col { flex: 1 1 0; min-width: 0; background: #f3f4f6; border-radius: 8px; padding: 8px; }
.col h2 { font-size: 13px; font-weight: 600; color: #374151; margin: 2px 4px 8px; display: flex; justify-content: space-between; }
.col h2 .n { color: #6b7280; font-weight: 500; }
.col.future h2 { color: #4b5563; }
.col.active h2 { color: #1d4ed8; }
.col.done h2 { color: #15803d; }
.card { background: #fff; border: 1px solid #e5e7eb; border-radius: 6px; padding: 8px 10px; margin: 0 0 8px; font-size: 13px; }
.card .t { font-weight: 600; }
.card .say { color: #374151; font-size: 12px; margin-top: 4px; }
.card .meta { color: #6b7280; font-size: 12px; margin-top: 2px; }
.card .who { color: #374151; font-size: 12px; margin-top: 4px; }
.card .links { font-size: 12px; margin-top: 4px; }
.bar { display: block; height: 4px; background: #e5e7eb; border-radius: 2px; margin-top: 6px; overflow: hidden; }
.bar span { display: block; height: 100%; background: #2563eb; }
.col.done .bar span { background: #16a34a; }
.empty { color: #9ca3af; font-size: 12px; margin: 2px 4px; }
#count { color: #6b7280; font-size: 13px; }
@media (max-width: 520px) { .board { flex-direction: column; } .col { width: 100%; box-sizing: border-box; } }
</style>
<script>if (/[?&]embed=1(&|$)/.test(location.search)) document.documentElement.className = "embed";</script>
</head>
<body>
<!-- Generated by the site skill's hierarchy word from the timeline facts. Regenerate it; do not edit it. -->
<h1>{{.Title}}</h1>
<div class="controls">
  <label>Repository <select id="repo"><option value="">all</option></select></label>
  <label>State <select id="state"><option value="">all</option><option value="open">open</option><option value="closed">closed</option></select></label>
  <label>Release <select id="release"><option value="">all</option></select></label>
  <label>Owner <select id="owner"><option value="">anyone</option></select></label>
  <label>Who <select id="who"><option value="">anyone</option></select></label>
{{- if .Stories}}
  <label>Epic <select id="epic"><option value="">all</option></select></label>
{{- end}}
  <span id="count"></span>
</div>
<div class="board" id="board">
  <div class="col future" data-col="future"><h2>Future <span class="n"></span></h2><div class="cards"></div></div>
  <div class="col active" data-col="active"><h2>Active <span class="n"></span></h2><div class="cards"></div></div>
  <div class="col done" data-col="done"><h2>Done <span class="n"></span></h2><div class="cards"></div></div>
</div>
<script type="application/json" id="list-data">{{.Data}}</script>
<script>
(function () {
  // The plan's epics or stories as a board (srd048 R8.12): the cards are
  // inlined, the page makes no request, and a document opens its page in the
  // site, in the top window, so the embedded board navigates the app. A
  // card's column is the document's state; open is anything not done.
  var D = JSON.parse(document.getElementById("list-data").textContent);
  var query = new URLSearchParams(location.search);
  var ids = ["repo", "state", "release", "owner", "who", "epic"];
  var state = {};
  ids.forEach(function (id) { state[id] = query.get(id) || ""; });
  var values = { repo: {}, release: {}, owner: {}, who: {}, epic: {} };
  D.rows.forEach(function (r) {
    values.repo[r.repository] = r.repository;
    if (r.release) values.release[r.release] = r.release;
    if (r.owner) values.owner[r.owner] = r.owner;
    (r.who || []).forEach(function (w) { values.who[w] = w; });
    if (r.epic) values.epic[r.epic] = r.epic_title;
  });
  function fill(id) {
    var sel = document.getElementById(id);
    if (!sel) { state[id] = ""; return; }
    Object.keys(values[id]).sort().forEach(function (v) {
      var o = document.createElement("option");
      o.value = v; o.textContent = values[id][v];
      sel.appendChild(o);
    });
    if (!values[id][state[id]]) state[id] = "";
    sel.value = state[id];
  }
  ["repo", "release", "owner", "who", "epic"].forEach(fill);
  if (state.state !== "open" && state.state !== "closed") state.state = "";
  document.getElementById("state").value = state.state;
  function esc(s) { return String(s == null ? "" : s).replace(/[&<>"]/g, function (c) { return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]; }); }
  function page(id) { return esc(new URL("../#/hierarchy/" + id, location.href).href); }
  function column(r) { return r.state === "done" || r.state === "active" ? r.state : "future"; }
  function card(r) {
    var div = document.createElement("div");
    div.className = "card";
    var h = '<div class="t"><a href="' + page(r.id) + '" target="_top">' + esc(r.title) + "</a></div>";
    if (r.statement) h += '<div class="say">' + esc(r.statement) + "</div>";
    if ((r.who || []).length) h += '<div class="who">' + esc(r.who.join(", ")) + "</div>";
    var meta = [esc(r.repository)];
    if (r.release) meta.push("release " + esc(r.release));
    else if (r.horizon) meta.push(esc(r.horizon));
    h += '<div class="meta">' + meta.join(" · ") + "</div>";
    if (r.owner) h += '<div class="meta">' + esc(r.owner) + "</div>";
    var work = [];
    if (r.below) work.push(esc(r.below));
    if (r.open_issues || r.closed_issues) work.push(r.open_issues + " open, " + r.closed_issues + " closed issues");
    if (work.length) h += '<div class="meta">' + work.join(" · ") + "</div>";
    if (r.epic) h += '<div class="links"><a href="' + page(r.epic) + '" target="_top">' + esc(r.epic_title) + "</a></div>";
    if (r.points) {
      h += '<div class="meta">' + r.points_done + " of " + r.points + " points</div>";
      h += '<span class="bar"><span style="width:' + Math.round(r.points_done * 100 / r.points) + '%"></span></span>';
    }
    div.innerHTML = h;
    return div;
  }
  function draw() {
    var kept = D.rows.filter(function (r) {
      if (state.repo && r.repository !== state.repo) return false;
      if (state.state === "open" && r.state === "done") return false;
      if (state.state === "closed" && r.state !== "done") return false;
      if (state.release && r.release !== state.release) return false;
      if (state.owner && r.owner !== state.owner) return false;
      if (state.who && (r.who || []).indexOf(state.who) < 0) return false;
      if (state.epic && r.epic !== state.epic) return false;
      return true;
    });
    document.querySelectorAll("#board .col").forEach(function (col) {
      var name = col.getAttribute("data-col");
      var cards = col.querySelector(".cards");
      cards.innerHTML = "";
      var mine = kept.filter(function (r) { return column(r) === name; });
      mine.forEach(function (r) { cards.appendChild(card(r)); });
      col.querySelector(".n").textContent = String(mine.length);
      if (mine.length === 0) {
        var p = document.createElement("div");
        p.className = "empty";
        p.textContent = "none";
        cards.appendChild(p);
      }
      // A state filter narrows the board to its columns: open hides done,
      // closed keeps only it.
      col.style.display =
        (state.state === "closed" && name !== "done") || (state.state === "open" && name === "done") ? "none" : "";
    });
    document.getElementById("count").textContent = kept.length + " of " + D.rows.length + " {{.Noun}}";
    // Embedded, the board tells the page holding it how tall it is, so the
    // page sizes its frame and the reader scrolls once (GH-136).
    if (window.parent !== window) {
      window.parent.postMessage({ timelineHeight: document.documentElement.scrollHeight }, "*");
    }
  }
  ids.forEach(function (id) {
    var sel = document.getElementById(id);
    if (sel) sel.addEventListener("change", function (e) { state[id] = e.target.value; draw(); });
  });
  draw();
})();
</script>
</body>
</html>
