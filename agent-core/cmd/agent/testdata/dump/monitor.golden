dump_version: 1
profile:
  name: monitor
  machine: <agent-core>/testdata/integration/profiles/monitor/machine.yaml
  tools:
    - <agent-core>/testdata/integration/profiles/monitor/tools.yaml
  tool_declarations:
    - <agent-core>/testdata/integration/profiles/monitor/declarations.yaml
  rest_definitions:
    - <agent-core>/testdata/integration/profiles/monitor/rest.yaml
machine:
  name: monitor-rest-profile
  purpose: Serve embedded monitor state until a control exit request arrives.
  configuration:
    machine: machine.yaml
    tools: tools.yaml
  metric_labels:
    profile: monitor
  initial_state: Idle
  states:
    - name: Idle
      meaning: Initial state before the monitor server starts.
    - name: Launching
      meaning: The REST server launch command is running.
    - name: AwaitingControl
      meaning: Monitor REST routes are available while the machine waits for a control event.
    - name: Stopping
      meaning: The machine stops the owned monitor REST listener.
    - name: Done
      meaning: Terminal. The monitor REST listener stopped without error.
      run_status: succeeded
    - name: Failed
      meaning: Terminal state for launch failures.
      run_status: failed
  terminal_states:
    - Done
    - Failed
  signals:
    - name: Seed
      trigger: Loop initialization.
    - name: ServerLaunched
      trigger: Monitor REST routes were registered.
    - name: ExitRequested
      trigger: Supervisor requested monitor exit through REST control.
    - name: AwaitTimedOut
      trigger: No matching control event arrived.
    - name: ServerStopped
      trigger: Monitor REST listener stopped.
    - name: CommandError
      trigger: REST server lifecycle command failed.
  transitions:
    - state: Idle
      signal: Seed
      next: Launching
      action: launch_monitor_rest
      label: monitor
      report_output: $.address
      metric_labels:
        route_group: monitor
    - state: Launching
      signal: ServerLaunched
      next: AwaitingControl
      action: await_monitor_control
    - state: Launching
      signal: CommandError
      next: Failed
    - state: AwaitingControl
      signal: ExitRequested
      next: Stopping
      action: stop_monitor_rest
    - state: AwaitingControl
      signal: AwaitTimedOut
      next: Failed
    - state: AwaitingControl
      signal: ServerStopped
      next: Failed
    - state: AwaitingControl
      signal: CommandError
      next: Failed
    - state: Stopping
      signal: ServerStopped
      next: Done
    - state: Stopping
      signal: CommandError
      next: Failed
  budget:
    max_iterations: 6
    command_timeout: 1m
instantiations:
  - kind: machine
    fragment: <agent-core>/tools/machines/monitor-service-machine-template.yaml
    args:
      machine: machine.yaml
      profile: monitor
      tools: tools.yaml
    produces:
      - machine/monitor-rest-profile
tools:
  - name: await_monitor_control
    type: builtin
    category: boundary
    description: Await the monitor control exit event.
    problem: Await the monitor control exit event.
    goals:
      - Await the monitor control exit event.
    requirements:
      input:
        - await_monitor_control declares no input type
      output:
        - await_monitor_control declares no output type
      errors:
        - await_monitor_control emits CommandError when it cannot produce its declared output
    non_goals:
      - Behavior outside await_monitor_control, which its signature states in full
    side_effects:
      - kind: state_mutation
        target: rest_server_queue
        state: selected_event_consumed
    reversibility:
      classification: reversible
    undo:
      strategy: queue_event_restore
      payload: rest_await_event
      captures:
        - source
        - event
    init: rest_await_event
    config:
      sources:
        - routes:
            - control_exit
          server: monitor
          signals:
            - ExitRequested
      stopped_behavior: emit_server_stopped
      timeout: 30s
    emits:
      - ExitRequested
      - AwaitTimedOut
      - ServerStopped
      - CommandError
    signature:
      emits:
        - ExitRequested
        - AwaitTimedOut
        - ServerStopped
        - CommandError
    parameters:
      properties: {}
      type: object
    visibility: internal
  - name: launch_monitor_rest
    type: builtin
    category: boundary
    description: Launch the embedded monitor REST server.
    problem: Launch the embedded monitor REST server.
    goals:
      - Launch the embedded monitor REST server.
    requirements:
      input:
        - launch_monitor_rest declares no input type
      output:
        - launch_monitor_rest declares no output type
      errors:
        - launch_monitor_rest emits CommandError when it cannot produce its declared output
    non_goals:
      - Behavior outside launch_monitor_rest, which its signature states in full
    side_effects:
      - kind: network_listen
        target: monitor
        state: listener_started
    reversibility:
      classification: compensatable
    undo:
      strategy: compensating_action
      description: Stop the monitor listener.
    init: rest_server_launch
    config:
      rest_ref: monitor
    emits:
      - ServerLaunched
      - CommandError
    signature:
      emits:
        - ServerLaunched
        - CommandError
    parameters:
      properties: {}
      type: object
    visibility: internal
  - name: stop_monitor_rest
    type: builtin
    category: boundary
    description: Stop the embedded monitor REST server.
    problem: Stop the embedded monitor REST server.
    goals:
      - Stop the embedded monitor REST server.
    requirements:
      input:
        - stop_monitor_rest declares no input type
      output:
        - stop_monitor_rest declares no output type
      errors:
        - stop_monitor_rest emits CommandError when it cannot produce its declared output
    non_goals:
      - Behavior outside stop_monitor_rest, which its signature states in full
    side_effects:
      - kind: network_listener_shutdown
        target: monitor
        state: listener_stopped
    reversibility:
      classification: reversible
    undo:
      strategy: noop
      description: Relaunch is a separate machine action.
    init: rest_server_stop
    config:
      rest_ref: monitor
    emits:
      - ServerStopped
      - CommandError
    signature:
      emits:
        - ServerStopped
        - CommandError
    parameters:
      properties: {}
      type: object
    visibility: internal
rest:
  version: v1
  servers:
    monitor:
      address: 127.0.0.1:0
      limits_ref: local_monitor
      queue:
        name: monitor
        capacity: 8
        overflow: reject
        timeout: 100ms
      endpoints:
        control_exit:
          method: POST
          path: /monitor/control/exit
          binding: emit_signal
          signal: ExitRequested
          request:
            body_schema:
              properties:
                reason:
                  type: string
              type: object
          response:
            output:
              accepted: "true"
          machine_request: {}
        current_state:
          method: GET
          path: /monitor/state
          binding: read_state
          monitor_view: current_state
          machine_request: {}
        declared_machines:
          method: GET
          path: /monitor/machines
          binding: read_state
          monitor_view: declared_machines
          machine_request: {}
        declared_tools:
          method: GET
          path: /monitor/tools/declared
          binding: read_state
          monitor_view: declared_tools
          machine_request: {}
        event_stream:
          method: GET
          path: /monitor/events/stream
          binding: stream_events
          monitor_view: events
          machine_request: {}
        machine_spec:
          method: GET
          path: /monitor/machine
          binding: read_state
          monitor_view: machine_spec
          machine_request: {}
        metrics:
          method: GET
          path: /monitor/metrics
          binding: read_state
          monitor_view: metrics
          machine_request: {}
        openapi:
          method: GET
          path: /monitor/openapi
          binding: static_metadata
          monitor_view: openapi
          machine_request: {}
        recent_events:
          method: GET
          path: /monitor/events
          binding: read_state
          monitor_view: events
          machine_request: {}
        tools:
          method: GET
          path: /monitor/tools
          binding: read_state
          monitor_view: tools
          machine_request: {}
      shutdown:
        timeout: 2s
        drain_policy: drain_then_stop
        stop_listeners: true
        unblock_await_signal: ServerStopped
  limits:
    local_monitor:
      timeout: 2s
      read_timeout: 2s
      max_request_bytes: 4096
      max_response_bytes: 1048576
      network:
        hosts:
          - 127.0.0.1
          - localhost
files:
  - path: <agent-core>/testdata/integration/profiles/monitor/declarations.yaml
    sha256: b5ad1c9006a7b12c66f1ed0cc7b1e825cead927a0acc32beb9a0e032edb21b23
  - path: <agent-core>/testdata/integration/profiles/monitor/machine.yaml
    sha256: 9a2e9e2697b00ca17f61a7f400d2b497803df23393184be808f042abf46ff78c
  - path: <agent-core>/testdata/integration/profiles/monitor/profile.yaml
    sha256: 3084e376fc7740cdb41e4ff80bd2d74c5d4e5abf1471630ffc595e9009ced05f
  - path: <agent-core>/testdata/integration/profiles/monitor/rest.yaml
    sha256: 053c00421f3abc63da89fd59fffaf7acca3040bdb279090d293a3ea4ba1a1799
  - path: <agent-core>/testdata/integration/profiles/monitor/tools.yaml
    sha256: 8978c7ba3ef4bc7e17a2330e20237640ad2349436fdb45406836a8b8550cecc5
