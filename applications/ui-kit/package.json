{
  "name": "@declarative-agents/ui-kit",
  "version": "1.1.0",
  "description": "Shared presentation contract clients, shell, tokens, and observability panels for declarative-agents UIs (srd004).",
  "license": "BSD-3-Clause",
  "type": "module",
  "files": [
    "dist",
    "src/tokens.css",
    "ui-config.d.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/ui-kit.js"
    },
    "./fixtures": {
      "types": "./dist/fixtures/index.d.ts",
      "import": "./dist/fixtures.js"
    },
    "./vite": {
      "types": "./dist/shell/vite-plugin-ui-yaml.d.ts",
      "import": "./dist/vite.js"
    },
    "./ui-config": {
      "types": "./ui-config.d.ts"
    },
    "./tokens.css": "./src/tokens.css",
    "./styles.css": "./dist/ui-kit.css"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && vitest run && npm run test:example",
    "test:example": "vite build --config examples/minimal/vite.config.ts --logLevel warn"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "jsdom": "^26.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  }
}
