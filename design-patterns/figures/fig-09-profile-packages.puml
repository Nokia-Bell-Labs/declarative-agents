@startuml
!theme plain

package "core/ (shared)" {
  [write_file.yaml] as a1
  [build.yaml] as a2
  [git_commit.yaml] as a3
}

package "executor/" {
  [invoke_llm.yaml] as b1
  [parse_response.yaml] as b2
}

package "critic/" {
  [run_point.yaml] as c1
  [classify.yaml] as c2
}

node "executor/profile.yaml" as GP
node "critic/profile.yaml" as EP

GP ..> "core/ (shared)" : import
GP ..> "executor/" : import
EP ..> "core/ (shared)" : import
EP ..> "critic/" : import
@enduml
