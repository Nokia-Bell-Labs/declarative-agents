dump_version: 1
profile:
  name: core-spec-audit
  machine: <agent-core>/testdata/integration/profiles/audit/machine.yaml
  tools:
    - <agent-core>/testdata/integration/profiles/audit/tools.yaml
  tool_declarations:
    - <agent-core>/tools/builtin/load-corpus.yaml
    - <agent-core>/tools/builtin/validate-specs.yaml
    - <agent-core>/tools/builtin/format-report.yaml
    - <agent-core>/tools/builtin/spec-validation/reduce-grep-checks.yaml
    - <agent-core>/tools/builtin/spec-validation/test-evidence.yaml
    - <agent-core>/testdata/integration/profiles/audit/ripgrep.yaml
machine:
  name: core-spec-audit
  purpose: Validate Agent Core specifications without a catalog checkout.
  initial_state: Idle
  states:
    - name: Idle
      meaning: Initial state.
    - name: Loading
      meaning: Loading the specification corpus.
    - name: Validating
      meaning: Validating references and structure.
    - name: Searching
      meaning: Running declared grep checks.
    - name: Reducing
      meaning: Reducing grep evidence.
    - name: Reporting
      meaning: Formatting findings.
    - name: Passed
      meaning: Terminal success.
      run_status: succeeded
    - name: Failed
      meaning: Terminal failure.
      run_status: failed
  terminal_states:
    - Passed
    - Failed
  signals:
    - name: Seed
      trigger: Loop initialization.
    - name: ToolDone
      trigger: Tool succeeded.
    - name: ToolFailed
      trigger: Tool found failures.
    - name: CommandError
      trigger: Infrastructure failed.
    - name: ValidationPassed
      trigger: Validation passed.
    - name: ValidationFailed
      trigger: Validation found errors.
    - name: GrepSearched
      trigger: Grep checks completed.
  transitions:
    - state: Idle
      signal: Seed
      next: Loading
      action: load_corpus
      label: loaded_corpus
    - state: Loading
      signal: ToolDone
      next: Validating
      action: validate_specs
    - state: Loading
      signal: CommandError
      next: Failed
    - state: Validating
      signal: ValidationPassed
      next: Searching
      action: jurist_rg
      label: grep_result
      for_each:
        items: $from(loaded_corpus).grep_checks
        as: grep_check
        mode: sequential
        failure: collect_all
        continue_on:
          - ToolDone
          - ToolFailed
        abort_on:
          - CommandError
        join:
          next: Searching
          signals:
            all_success: GrepSearched
            partial: CommandError
            failed: CommandError
            empty: GrepSearched
          label: grep_results
    - state: Validating
      signal: ValidationFailed
      next: Searching
      action: jurist_rg
      label: grep_result
      for_each:
        items: $from(loaded_corpus).grep_checks
        as: grep_check
        mode: sequential
        failure: collect_all
        continue_on:
          - ToolDone
          - ToolFailed
        abort_on:
          - CommandError
        join:
          next: Searching
          signals:
            all_success: GrepSearched
            partial: CommandError
            failed: CommandError
            empty: GrepSearched
          label: grep_results
    - state: Validating
      signal: CommandError
      next: Failed
    - state: Searching
      signal: GrepSearched
      next: Reducing
      action: reduce_grep_checks
    - state: Searching
      signal: CommandError
      next: Failed
    - state: Reducing
      signal: ValidationPassed
      next: Reporting
      action: format_report
    - state: Reducing
      signal: ValidationFailed
      next: Reporting
      action: format_report
    - state: Reducing
      signal: CommandError
      next: Failed
    - state: Reporting
      signal: ToolDone
      next: Passed
    - state: Reporting
      signal: ToolFailed
      next: Failed
    - state: Reporting
      signal: CommandError
      next: Failed
  budget:
    max_iterations: 100
    command_timeout: 15m
types:
  - ref: builtin-types-core.AnyValue
    description: Any JSON value accepted by the schema configured on the word.
    schema:
      description: The runtime value is any JSON value accepted by the configured schema.
  - ref: builtin-types-core.CommandSummary
    description: The message and outcome signal a command word publishes.
    schema:
      properties:
        message:
          type: string
        signal:
          type: string
      required:
        - message
      type: object
  - ref: builtin-types-core.NoParameters
    description: The empty parameter object of a word whose input arrives through config selectors.
    schema:
      properties: {}
      type: object
  - ref: builtin-types-core.Text
    description: Plain text a word publishes as its whole result.
    schema:
      type: string
tools:
  - name: format_report
    type: builtin
    category: word
    description: Format the validation results as a human-readable report.
    problem: Format the validation results as a human-readable report.
    goals:
      - Format the validation results as a human-readable report.
    requirements:
      input:
        - format_report declares no input type
      output:
        - format_report takes its output as builtin-types-core.Text
      errors:
        - format_report emits CommandError when it cannot produce its declared output
    non_goals:
      - Behavior outside format_report, which its signature states in full
    output:
      description: Plain-text human-readable validation report.
      schema:
        type: string
    side_effects:
      - kind: stderr_write
        target: process_stderr
        description: Prints the human-readable validation report to stderr.
    reversibility:
      classification: reversible
    undo:
      strategy: noop
      description: format_report mutates nothing, so undo does nothing
    errors:
      - signal: ToolFailed
        condition: the validation finding set contains one or more error-level findings
        message_shape: <human-readable validation report>
        state_after_failure: the complete report is printed and returned
    init: format_report
    emits:
      - ToolDone
      - ToolFailed
    signature:
      output: builtin-types-core.Text
      emits:
        - ToolDone
        - ToolFailed
    visibility: internal
  - name: jurist_rg
    type: exec
    description: ""
    output:
      schema:
        properties:
          exit_code:
            type: integer
          output:
            type: string
        required:
          - output
          - exit_code
        type: object
      mode: structured
    binary: rg
    args:
      - --json
      - --line-number
      - --no-ignore
      - --hidden
      - --text
      - --threads
      - "1"
      - --sort
      - path
    emits:
      - ToolDone
      - ToolFailed
      - CommandError
    parameters:
      properties:
        exclude_glob:
          flag: --glob
          position: 2
          source: $from(grep_check).exclude_glob
          type: string
        include_glob:
          flag: --glob
          position: 1
          source: $from(grep_check).include_glob
          type: string
        path:
          position: 4
          positional: true
          source: $from(grep_check).path
          type: string
        query:
          position: 3
          positional: true
          source: $from(grep_check).query
          type: string
      required:
        - query
        - path
      type: object
    visibility: internal
    output_cap: 1048576
  - name: load_corpus
    type: builtin
    category: stateful_internal
    description: Load the specification corpus from the project directory.
    problem: The machine needs a declared word for loading the specification corpus without embedding that workflow step in Go control flow.
    goals:
      - Perform the load_corpus action as one machine-selected word.
      - Return an explicit signal that lets the MachineSpec choose the next state.
      - Keep sequencing outside the tool implementation and in machine.yaml.
    requirements:
      input:
        - must consume parameters from tool input, prior Result, or configured command/domain state
      output:
        - must emit one declared signal and return machine-readable output when available
      errors:
        - must emit CommandError for infrastructure failures and preserve domain failures as declared signals
    non_goals:
      - Does not choose the next workflow step; machine.yaml owns sequencing.
      - Does not hide unrelated tool execution behind this word.
    output:
      description: Loaded corpus summary and the declared search plans consumed by the specification-critic machine.
      schema:
        properties:
          consistency_checks:
            items:
              type: object
            type: array
          grep_checks:
            items:
              type: object
            type: array
          ref_checks:
            items:
              type: object
            type: array
          summary:
            type: string
        required:
          - summary
          - grep_checks
          - ref_checks
          - consistency_checks
        type: object
    side_effects:
      - kind: state_mutation
        target: validation_state
        state: corpus_loaded
        description: Loads specification documents into validation state.
    reversibility:
      classification: reversible
    undo:
      strategy: session_state_restore
      description: Restore validation state to the snapshot before loading the corpus.
    errors:
      - signal: CommandError
        condition: required input, configuration, or runtime state is invalid
        message_shape: 'load_corpus: <error>'
        state_after_failure: no additional workflow step is executed by this tool
    relationships:
      before:
        - machine-selected predecessor
      after:
        - machine-selected successor
    init: load_corpus
    config:
      suite_paths:
        - /opt/agent-core/tools/builtin/spec-validation/spec-corpus-charter.yaml
    emits:
      - ToolDone
      - CommandError
    visibility: internal
  - name: reduce_grep_checks
    type: builtin
    category: stateful_internal
    description: Shape joined ripgrep events into deterministic jurist findings.
    problem: grep_check match policy and finding provenance need a visible reduction step after external search.
    goals:
      - Map rg match and missing outcomes to charter findings.
      - Preserve suite, check, severity, path, and line provenance.
    requirements:
      input:
        - must consume the joined structured outputs of declared jurist_rg executions
      output:
        - must emit ValidationPassed or ValidationFailed from the complete finding set
      errors:
        - must reject malformed rg events and rg exit codes above one as CommandError
    non_goals:
      - Does not read or scan target files.
      - Does not execute search subprocesses.
    output:
      description: Plain-text aggregate jurist finding and error count.
      schema:
        type: string
    side_effects:
      - kind: state_mutation
        target: validation_state
        state: grep_findings_recorded
        description: Appends reduced grep findings to validation state.
    reversibility:
      classification: reversible
    undo:
      strategy: session_state_restore
      description: Restore validation state to the snapshot before grep reduction.
    errors:
      - signal: CommandError
        condition: Joined rg output is malformed or reports an exit code above one.
        message_shape: 'reduce grep checks failed: <error>'
        state_after_failure: No additional workflow step is executed.
    relationships:
      before:
        - jurist_rg
      after:
        - format_report
    init: reduce_grep_checks
    config:
      results_from: $from(grep_results).items
    emits:
      - ValidationPassed
      - ValidationFailed
      - CommandError
    visibility: internal
  - name: validate_specs
    type: builtin
    category: stateful_internal
    description: Run consistency checks on the loaded specification corpus.
    problem: The machine needs a declared word for validating specification graph consistency without embedding that workflow step in Go control flow.
    goals:
      - Perform the validate_specs action as one machine-selected word.
      - Return an explicit signal that lets the MachineSpec choose the next state.
      - Keep sequencing outside the tool implementation and in machine.yaml.
    requirements:
      input:
        - must consume parameters from tool input, prior Result, or configured command/domain state
      output:
        - must emit one declared signal and return machine-readable output when available
      errors:
        - must emit CommandError for infrastructure failures and preserve domain failures as declared signals
    non_goals:
      - Does not choose the next workflow step; machine.yaml owns sequencing.
      - Does not hide unrelated tool execution behind this word.
    output:
      description: Plain-text finding and error count summary.
      schema:
        type: string
    side_effects:
      - kind: state_mutation
        target: validation_state
        state: validation_results_recorded
        description: Records validation findings in validation state.
    reversibility:
      classification: reversible
    undo:
      strategy: session_state_restore
      description: Restore validation state to the snapshot before running checks.
    errors:
      - signal: CommandError
        condition: required input, configuration, or runtime state is invalid
        message_shape: 'validate_specs: <error>'
        state_after_failure: no additional workflow step is executed by this tool
    relationships:
      before:
        - machine-selected predecessor
      after:
        - machine-selected successor
    init: validate_specs
    emits:
      - ValidationPassed
      - ValidationFailed
      - CommandError
    visibility: internal
rest: {}
