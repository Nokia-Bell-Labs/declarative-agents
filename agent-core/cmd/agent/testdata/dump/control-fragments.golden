dump_version: 1
profile:
  name: core-control-fragments
  machine: <agent-core>/testdata/integration/profiles/control-fragments/machine.yaml
  tools:
    - <agent-core>/testdata/integration/profiles/control-fragments/tools.yaml
  tool_declarations:
    - <agent-core>/testdata/integration/profiles/control-fragments/declarations.yaml
  rest_definitions:
    - <agent-core>/testdata/integration/profiles/control-fragments/rest.yaml
machine:
  name: core-control-fragments
  purpose: Prove a fragment instantiated twice drives the same control flow as hand-written declarations.
  initial_state: Idle
  states:
    - name: Idle
      meaning: Initial state.
    - name: Launching
      meaning: Starting the control server.
    - name: Awaiting
      meaning: Waiting for an exit request.
    - name: Exiting
      meaning: Dispatching exit_agent.
    - name: Retrying
      meaning: Relaunching the control server with a patient await.
    - name: Patient
      meaning: Waiting longer for an exit request.
    - name: Succeeded
      meaning: Terminal success.
      run_status: succeeded
    - name: Failed
      meaning: Terminal failure.
      run_status: failed
  terminal_states:
    - Succeeded
    - Failed
  signals:
    - name: Seed
      trigger: Loop initialization.
    - name: ServerLaunched
      trigger: Control server started.
    - name: ExitRequested
      trigger: Operator requested exit.
    - name: AwaitTimedOut
      trigger: No event arrived.
    - name: ServerStopped
      trigger: Server stopped.
    - name: AgentExited
      trigger: exit_agent requested shutdown.
    - name: CommandError
      trigger: Runtime failure.
  transitions:
    - state: Idle
      signal: Seed
      next: Launching
      action: primary_launch_agent_control
    - state: Launching
      signal: ServerLaunched
      next: Awaiting
      action: primary_await_agent_control
    - state: Launching
      signal: CommandError
      next: Failed
    - state: Awaiting
      signal: ExitRequested
      next: Exiting
      action: exit_agent
    - state: Awaiting
      signal: AwaitTimedOut
      next: Retrying
      action: patient_launch_agent_control
    - state: Awaiting
      signal: ServerStopped
      next: Failed
    - state: Awaiting
      signal: CommandError
      next: Failed
    - state: Exiting
      signal: AgentExited
      next: Succeeded
    - state: Exiting
      signal: CommandError
      next: Failed
    - state: Retrying
      signal: ServerLaunched
      next: Patient
      action: patient_await_agent_control
    - state: Retrying
      signal: CommandError
      next: Failed
    - state: Patient
      signal: ExitRequested
      next: Exiting
      action: exit_agent
    - state: Patient
      signal: AwaitTimedOut
      next: Failed
    - state: Patient
      signal: ServerStopped
      next: Failed
    - state: Patient
      signal: CommandError
      next: Failed
  budget:
    max_iterations: 5
    command_timeout: 1m
types:
  - ref: control-types.ExitOutcome
    description: The outcome an exiting control agent reports.
    schema:
      properties:
        detail:
          type: string
        status:
          enum:
            - exited
            - refused
          type: string
      required:
        - status
      type: object
  - ref: control-types.ExitReport
    description: An exit outcome with the request that produced it.
    schema:
      properties:
        outcome:
          $type: control-types.ExitOutcome
        requests:
          items:
            type: integer
          type: array
      type: object
instantiations:
  - fragment: <agent-core>/testdata/integration/units/control-tool-fragment.yaml
    as: patient
    args:
      server: agent_control
      timeout: 45s
    produces:
      - patient_await_agent_control
      - patient_launch_agent_control
  - fragment: <agent-core>/testdata/integration/units/control-tool-fragment.yaml
    as: primary
    args:
      server: agent_control
      timeout: 30s
    produces:
      - primary_await_agent_control
      - primary_launch_agent_control
tools:
  - name: exit_agent
    type: builtin
    category: lifecycle
    description: ""
    output:
      description: The outcome of the exit request.
      schema:
        properties:
          outcome:
            properties:
              detail:
                type: string
              status:
                enum:
                  - exited
                  - refused
                type: string
            required:
              - status
            type: object
          requests:
            items:
              type: integer
            type: array
        type: object
    init: exit_agent
    emits:
      - AgentExited
      - CommandError
    visibility: internal
    override: true
  - name: patient_await_agent_control
    type: builtin
    category: boundary
    description: ""
    init: rest_await_event
    config:
      sources:
        - routes:
            - exit
          server: agent_control
          signals:
            - ExitRequested
      stopped_behavior: emit_server_stopped
      timeout: 45s
    emits:
      - ExitRequested
      - AwaitTimedOut
      - ServerStopped
      - CommandError
    visibility: internal
  - name: patient_launch_agent_control
    type: builtin
    category: boundary
    description: ""
    init: rest_server_launch
    config:
      rest_ref: agent_control
    emits:
      - ServerLaunched
      - CommandError
    visibility: internal
  - name: primary_await_agent_control
    type: builtin
    category: boundary
    description: ""
    init: rest_await_event
    config:
      sources:
        - routes:
            - exit
          server: agent_control
          signals:
            - ExitRequested
      stopped_behavior: emit_server_stopped
      timeout: 30s
    emits:
      - ExitRequested
      - AwaitTimedOut
      - ServerStopped
      - CommandError
    visibility: internal
  - name: primary_launch_agent_control
    type: builtin
    category: boundary
    description: ""
    init: rest_server_launch
    config:
      rest_ref: agent_control
    emits:
      - ServerLaunched
      - CommandError
    visibility: internal
rest:
  version: v1
  servers:
    agent_control:
      address: 127.0.0.1:0
      limits_ref: local
      queue:
        name: agent_control
        capacity: 8
        timeout: 30s
      endpoints:
        exit:
          method: POST
          path: /api/lifecycle/exit
          binding: emit_signal
          signal: ExitRequested
          request:
            body_schema:
              properties:
                reason:
                  type: string
              type: object
          response:
            output:
              accepted: "true"
          machine_request: {}
      shutdown:
        timeout: 5s
        drain_policy: drain_then_stop
  limits:
    local:
      timeout: 30s
      read_timeout: 5s
      max_request_bytes: 16384
      max_response_bytes: 65536
      redirect:
        mode: none
      network:
        hosts:
          - 127.0.0.1
          - localhost
        ports:
          - 0
files:
  - path: <agent-core>/testdata/integration/profiles/control-fragments/declarations.yaml
    sha256: 5efd8d3b92a963b2d6a3d31ae85ce419fdb7bca7847987c02ec186f8de3fd8bd
