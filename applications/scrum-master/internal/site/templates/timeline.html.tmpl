<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{.Title}}</title>
<style>
body { font-family: system-ui, sans-serif; margin: 1rem; color: #1f2937; }
html.embed body { margin: 0; }
html.embed h1 { display: none; }
.controls { display: flex; flex-wrap: wrap; gap: 8px 16px; align-items: center; margin: 0 0 8px; font-size: 14px; }
.controls .group { display: inline-flex; border: 1px solid #d1d5db; border-radius: 6px; overflow: hidden; }
.controls button { border: 0; background: #fff; padding: 4px 10px; font: inherit; cursor: pointer; }
.controls button + button { border-left: 1px solid #d1d5db; }
.controls button.on { background: #2563eb; color: #fff; }
.legend { display: flex; flex-wrap: wrap; gap: 4px 14px; margin: 0 0 8px; font-size: 12px; color: #4b5563; align-items: center; }
.legend svg { vertical-align: -2px; margin-right: 4px; }
.chart { display: flex; align-items: flex-start; border: 1px solid #e5e7eb; border-radius: 6px; }
#tree { flex: 0 0 260px; width: 260px; min-width: 0; overflow: hidden; border-right: 1px solid #e5e7eb; font-size: 13px; }
html.embed #tree { flex-basis: 200px; width: 200px; }
#plot { flex: 1 1 0; min-width: 0; overflow-x: auto; }
#tree .head { box-sizing: border-box; display: flex; align-items: flex-end; padding: 0 6px 6px; border-bottom: 1px solid #e5e7eb;
  font-weight: 600; color: #6b7280; }
#tree .row { box-sizing: border-box; display: flex; align-items: center; white-space: nowrap; padding-right: 6px;
  border-bottom: 1px solid #f3f4f6; }
#tree .tw { flex: none; width: 16px; text-align: center; font-size: 13px; color: #4b5563; cursor: pointer; user-select: none; }
#tree .chip { flex: none; width: 10px; height: 10px; border-radius: 2px; margin-right: 6px; }
#tree .name { flex: 1 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; cursor: pointer; }
#tree .name:hover { color: #2563eb; text-decoration: underline; }
#tree .kind { flex: none; margin-left: 6px; font-size: 11px; color: #9ca3af; }
#tip { position: fixed; z-index: 10; pointer-events: none; background: #111827; color: #f9fafb; font-size: 12px; line-height: 1.4;
  padding: 6px 8px; border-radius: 6px; max-width: 320px; box-shadow: 0 2px 8px rgba(0,0,0,.25); }
#tip b { color: #fff; }
svg text { font-family: system-ui, sans-serif; }
.hit { cursor: pointer; }
</style>
<script>if (/[?&]embed=1(&|$)/.test(location.search)) document.documentElement.className = "embed";</script>
</head>
<body>
<!-- Generated by the site skill's gantt word from the timeline facts. Regenerate it; do not edit it. -->
<h1>{{.Title}}</h1>
<div class="controls">
  <span class="group" id="views"><button data-view="timeline">Timeline</button><button data-view="roadmap">Road map</button></span>
  <span class="group" id="zoom"><button data-mode="Week">Week</button><button data-mode="Sprint">Sprint</button><button data-mode="Quarter">Quarter</button></span>
  <label>Compare with the plan at <select id="plan"><option value="-1">none</option></select></label>
</div>
<div class="legend" id="legend"></div>
<p id="empty" hidden>Nothing on this plan has planned days.</p>
<div class="chart"><div id="tree"></div><div id="plot"></div></div>
<div id="tip" hidden></div>
<script type="application/json" id="chart-data">{{.Data}}</script>
<script>
(function () {
  // The plan drawn as what each item is (srd048 R5.3, GH-136): the sprint
  // grid; releases as lines at their sprints' ends; themes, initiatives,
  // and features as summary brackets, an initiative with a diamond at each
  // requirement group's due date; epics as bars filled by their points;
  // stories as blocks in their sprints; Sprint Goals as flags on the epics
  // they serve; an item's actual days as a thin bar beneath its plan, a
  // story's from its issues; the plan at a corpus tag as a ghost behind;
  // dependencies as elbow arrows; today as a line.
  var D = JSON.parse(document.getElementById("chart-data").textContent);
  var DAY = 86400000, ROW = 34, HEAD = 52, NS = "http://www.w3.org/2000/svg";
  var PLAN = ["theme", "initiative", "epic", "feature", "story"];
  var SUMMARY = { theme: true, initiative: true, feature: true };
  var TONE = { // light, mid, dark per kind
    theme: ["#ede9fe", "#c4b5fd", "#6d28d9"], initiative: ["#dbeafe", "#93c5fd", "#1d4ed8"], epic: ["#ccfbf1", "#5eead4", "#0f766e"],
    feature: ["#fef3c7", "#fcd34d", "#b45309"], story: ["#dcfce7", "#86efac", "#15803d"]
  };
  var GOAL = { done: "#16a34a", active: "#d97706", future: "#94a3b8" };
  var RELEASE = { released: "#16a34a", current: "#2563eb", future: "#94a3b8" };
  var query = new URLSearchParams(location.search);
  var view = query.get("view") === "roadmap" ? "roadmap" : "timeline";
  var state = { view: view, mode: query.get("mode") || (view === "roadmap" ? "Quarter" : "Sprint"), ghost: -1, opened: { timeline: {}, roadmap: {} } };

  function day(s) { var p = s.split("-"); return new Date(+p[0], +p[1] - 1, +p[2]); }
  function iso(d) { return d.getFullYear() + "-" + String(d.getMonth() + 1).padStart(2, "0") + "-" + String(d.getDate()).padStart(2, "0"); }
  function addDays(d, n) { return new Date(d.getFullYear(), d.getMonth(), d.getDate() + n); }
  function isoWeek(d) {
    var t = new Date(Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()));
    t.setUTCDate(t.getUTCDate() + 3 - (t.getUTCDay() + 6) % 7);
    var jan4 = new Date(Date.UTC(t.getUTCFullYear(), 0, 4));
    return 1 + Math.round(((t - jan4) / DAY - 3 + (jan4.getUTCDay() + 6) % 7) / 7);
  }
  function el(name, attrs, parent) {
    var e = document.createElementNS(NS, name);
    for (var k in attrs) e.setAttribute(k, attrs[k]);
    if (parent) parent.appendChild(e);
    return e;
  }

  // The plan's tree: planning items under their parents; Sprint Goals and
  // issues are no rows, they mark the rows they serve.
  var byId = {}, kids = {}, goals = [], issuesOf = {};
  D.Items = D.items;
  D.items.forEach(function (it) { byId[it.id] = it; });
  D.items.forEach(function (it) {
    if (PLAN.indexOf(it.kind) >= 0) {
      var p = it.parent && byId[it.parent] && PLAN.indexOf(byId[it.parent].kind) >= 0 ? it.parent : "";
      (kids[p] = kids[p] || []).push(it);
    } else if (it.kind === "sprint_goal") {
      goals.push(it);
    } else if (it.kind === "issue" && it.parent) {
      (issuesOf[it.parent] = issuesOf[it.parent] || []).push(it);
    }
  });
  function order(list) {
    return list.slice().sort(function (a, b) {
      var k = PLAN.indexOf(a.kind) - PLAN.indexOf(b.kind);
      if (k) return k;
      var ra = parseInt(a.rank, 10), rb = parseInt(b.rank, 10);
      if (!isNaN(ra) && !isNaN(rb) && ra !== rb) return ra - rb;
      return a.id < b.id ? -1 : a.id > b.id ? 1 : 0;
    });
  }
  // A story's actual days are its own, else its issues': the first opened
  // to the last closed, open-ended while any is open.
  function actual(it) {
    if (it.actual && it.actual.start) return it.actual;
    var is = issuesOf[it.id];
    if (!is || !is.length) return null;
    var start = null, end = null, open = false;
    is.forEach(function (i) {
      if (!i.actual || !i.actual.start) return;
      if (!start || i.actual.start < start) start = i.actual.start;
      if (i.actual.end) { if (!end || i.actual.end > end) end = i.actual.end; } else open = true;
    });
    return start ? { start: start, end: open ? "" : end } : null;
  }
  // A Sprint Goal flags each epic whose stories it selects, at its
  // release's sprint end.
  var releaseBy = {};
  D.releases.forEach(function (r) { releaseBy[r.version] = r; });
  var flagsOf = {};
  goals.forEach(function (g) {
    var r = releaseBy[g.release];
    var at = r && r.sprint ? r.sprint.end : (g.planned ? g.planned.end : "");
    if (!at) return;
    var seen = {};
    (g.selects || []).forEach(function (s) {
      for (var cur = byId[s]; cur; cur = byId[cur.parent]) {
        if (cur.kind === "epic") { if (!seen[cur.id]) { seen[cur.id] = true; (flagsOf[cur.id] = flagsOf[cur.id] || []).push({ goal: g, at: at }); } break; }
      }
    });
  });
  function isOpen(it) {
    var o = state.opened[state.view];
    if (it.id in o) return o[it.id];
    return state.view === "roadmap" ? it.kind === "theme" : it.kind === "theme" || it.kind === "initiative";
  }
  function rows() {
    var out = [];
    (function walk(list, depth) {
      order(list).forEach(function (it) {
        var children = kids[it.id] || [];
        out.push({ it: it, depth: depth, hasKids: children.length > 0 });
        if (children.length && isOpen(it)) walk(children, depth + 1);
      });
    })(kids[""] || [], 0);
    return out;
  }

  // The scale: Week, Sprint (three weeks from the earliest release
  // sprint), or Quarter, starting on a boundary before the earliest day
  // drawn.
  var MODES = { Week: { px: 140 / 7 }, Sprint: { px: 120 / 21 }, Quarter: { px: 120 / 91 } };
  function bounds(list) {
    var lo = day(D.today), hi = day(D.today);
    function see(span) {
      if (!span) return;
      if (span.start) { var s = day(span.start); if (s < lo) lo = s; if (s > hi) hi = s; }
      if (span.end) { var e = day(span.end); if (e > hi) hi = e; if (e < lo) lo = e; }
    }
    list.forEach(function (r) {
      see(r.it.planned); see(actual(r.it));
      (r.it.due || []).forEach(function (d) { see({ start: d.date }); });
      if (state.ghost >= 0) see(D.plans[state.ghost].planned[r.it.id]);
    });
    D.releases.forEach(function (r) { see(r.sprint); });
    return [lo, hi];
  }
  function grid(lo, hi) {
    var start, step;
    if (state.mode === "Week") {
      start = addDays(lo, -((lo.getDay() + 6) % 7) - 7);
      step = function (d) { return addDays(d, 7); };
    } else if (state.mode === "Sprint") {
      var o = D.origin ? day(D.origin) : addDays(lo, -((lo.getDay() + 6) % 7));
      var off = ((Math.round((lo - o) / DAY) % 21) + 21) % 21;
      start = addDays(lo, -off - 21);
      step = function (d) { return addDays(d, 21); };
    } else {
      start = new Date(lo.getFullYear(), Math.floor(lo.getMonth() / 3) * 3 - 3, 1);
      step = function (d) { return new Date(d.getFullYear(), d.getMonth() + 3, 1); };
    }
    var cols = [start];
    while (cols[cols.length - 1] <= addDays(hi, 21)) cols.push(step(cols[cols.length - 1]));
    return cols;
  }
  function lowerLabel(d) {
    if (state.mode === "Week") return "W" + isoWeek(d);
    if (state.mode === "Sprint") return "W" + isoWeek(d) + "–" + isoWeek(addDays(d, 14));
    return "Q" + (Math.floor(d.getMonth() / 3) + 1);
  }
  function upperLabel(d, prev) {
    if (state.mode === "Quarter") return !prev || d.getFullYear() !== prev.getFullYear() ? String(d.getFullYear()) : "";
    if (prev && d.getMonth() === prev.getMonth()) return "";
    return d.toLocaleString("en", !prev || d.getFullYear() !== prev.getFullYear() ? { month: "short", year: "numeric" } : { month: "short" });
  }

  var tip = document.getElementById("tip");
  function hint(node, html, target) {
    node.classList.add("hit");
    node.addEventListener("mousemove", function (e) {
      tip.innerHTML = html; tip.hidden = false;
      tip.style.left = Math.min(e.clientX + 12, innerWidth - 330) + "px"; tip.style.top = (e.clientY + 14) + "px";
    });
    node.addEventListener("mouseleave", function () { tip.hidden = true; });
    if (target) node.addEventListener("click", function () { go(target); });
  }
  function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]; }); }
  function span(s) { return s ? (s.start || "?") + " to " + (s.end || "now") : "none"; }
  // A planning item opens its page in the site, in the top window, so the
  // embedded chart navigates the app; a Sprint Goal or issue its tracker.
  function go(it) {
    if (PLAN.indexOf(it.kind) >= 0) window.top.location.href = new URL("../../#/hierarchy/" + it.id, location.href).href;
    else if (it.url && /^https?:/.test(it.url)) window.open(it.url, "_blank");
  }
  function about(it) {
    var a = actual(it), h = "<b>" + esc(it.title) + "</b><br>" + esc(it.kind) + " " + esc(it.id) + ", " + esc(it.status);
    if (it.points) h += ", " + it.points_done + " of " + it.points + " points";
    h += "<br>planned " + span(it.planned) + (a ? "<br>actual " + span(a) : "");
    if (state.ghost >= 0) h += "<br>at " + esc(D.plans[state.ghost].label) + ": " + span(D.plans[state.ghost].planned[it.id]);
    if (it.depends_on && it.depends_on.length) h += "<br>depends on " + it.depends_on.map(esc).join(", ");
    return h;
  }

  function draw(keep) {
    var plot = document.getElementById("plot"), left = plot.scrollLeft, top = window.scrollY;
    var list = rows();
    document.getElementById("empty").hidden = list.length > 0;
    var b = bounds(list), cols = grid(b[0], b[1]), x0 = cols[0], px = MODES[state.mode].px;
    function x(s) { return Math.round((day(s) - x0) / DAY * px); }
    function xEnd(s) { return x(s) + px; } // the end of the day
    var W = Math.round((cols[cols.length - 1] - x0) / DAY * px), H = HEAD + list.length * ROW;
    plot.innerHTML = "";
    var svg = el("svg", { width: W, height: H, viewBox: "0 0 " + W + " " + H }, plot);
    var defs = el("defs", {}, svg);
    ["#94a3b8", "#d97706"].forEach(function (c, i) {
      var m = el("marker", { id: "arrow" + i, viewBox: "0 0 8 8", refX: 7, refY: 4, markerWidth: 7, markerHeight: 7, orient: "auto-start-reverse" }, defs);
      el("path", { d: "M0,0 L8,4 L0,8 z", fill: c }, m);
    });
    // The grid and its header.
    el("rect", { x: 0, y: 0, width: W, height: HEAD, fill: "#f9fafb" }, svg);
    var prev = null;
    cols.forEach(function (c, i) {
      if (i === cols.length - 1) return;
      var cx = Math.round((c - x0) / DAY * px), cw = Math.round((cols[i + 1] - c) / DAY * px);
      if (i % 2 === 1) el("rect", { x: cx, y: HEAD, width: cw, height: H - HEAD, fill: "#fafafa" }, svg);
      el("line", { x1: cx, y1: 26, x2: cx, y2: H, stroke: "#e5e7eb" }, svg);
      var up = upperLabel(c, prev);
      if (up) el("text", { x: cx + 4, y: 17, "font-size": 12, "font-weight": 600, fill: "#374151" }, svg).textContent = up;
      el("text", { x: cx + cw / 2, y: 42, "font-size": 11, fill: "#6b7280", "text-anchor": "middle" }, svg).textContent = lowerLabel(c);
      prev = c;
    });
    el("line", { x1: 0, y1: HEAD, x2: W, y2: HEAD, stroke: "#d1d5db" }, svg);
    list.forEach(function (r, i) { el("line", { x1: 0, y1: HEAD + (i + 1) * ROW, x2: W, y2: HEAD + (i + 1) * ROW, stroke: "#f3f4f6" }, svg); });
    // Releases: a line at each sprint's end, labelled.
    var lines = el("g", {}, svg), lastLabel = -1e9;
    D.releases.forEach(function (r) {
      if (!r.sprint || !r.sprint.end) return;
      var rx = xEnd(r.sprint.end);
      var kind = r.status === "released" ? "released" : (D.today >= r.sprint.start && D.today <= r.sprint.end ? "current" : "future");
      var c = RELEASE[kind];
      el("line", { x1: rx, y1: 26, x2: rx, y2: H, stroke: c, "stroke-width": 2, "stroke-dasharray": kind === "released" ? "" : "5 4" }, lines);
      // A label that would run into the one before shortens to the
      // version, or, with no room even for that, is left to the line's
      // hover. lastLabel is where the label before ends.
      var full = r.version + " " + r.status, room = rx + 4 - lastLabel;
      var text = room > full.length * 6.5 ? full : room > r.version.length * 6.5 ? r.version : "";
      var label = el("text", { x: rx + 4, y: 30, "font-size": 11, "font-weight": 600, fill: c }, lines);
      label.textContent = text;
      if (text) lastLabel = rx + 4 + text.length * 6.5 + 4;
      var about = "<b>Release " + esc(r.version) + "</b>, " + esc(r.status) + (r.tag ? "<br>" + esc(r.tag) : "") + "<br>sprint " + span(r.sprint);
      hint(label, about);
      hint(el("rect", { x: rx - 4, y: 26, width: 8, height: H - 26, fill: "transparent" }, lines), about);
    });
    // Today.
    var tx = x(D.today) + px / 2;
    el("line", { x1: tx, y1: 26, x2: tx, y2: H, stroke: "#dc2626", "stroke-width": 1.5 }, svg);
    // Rows.
    var place = {}, arrows = el("g", {}, svg), shapes = el("g", {}, svg);
    list.forEach(function (r, i) {
      var it = r.it, y = HEAD + i * ROW, mid = y + ROW / 2, tone = TONE[it.kind] || TONE.epic;
      var g = el("g", {}, shapes);
      var ghost = state.ghost >= 0 ? D.plans[state.ghost].planned[it.id] : null;
      if (ghost && ghost.start && ghost.end) {
        el("rect", { x: x(ghost.start), y: mid - 9, width: Math.max(xEnd(ghost.end) - x(ghost.start), 2), height: 18, rx: 3,
          fill: "none", stroke: "#94a3b8", "stroke-width": 1.2, "stroke-dasharray": "4 3" }, g);
      }
      var p = it.planned;
      if (p && p.start && p.end) {
        var px0 = x(p.start), w = Math.max(xEnd(p.end) - px0, 3);
        place[it.id] = { x0: px0, x1: px0 + w, y: mid };
        var shape;
        if (SUMMARY[it.kind]) {
          // A summary bracket: a thin bar with end caps.
          shape = el("g", {}, g);
          el("rect", { x: px0, y: mid - 7, width: w, height: 5, fill: tone[1] }, shape);
          el("path", { d: "M" + px0 + "," + (mid - 7) + " l0,11 l6,-6 z M" + (px0 + w) + "," + (mid - 7) + " l0,11 l-6,-6 z", fill: tone[2] }, shape);
        } else {
          var h = it.kind === "story" ? 16 : 18, done = it.status === "done", future = it.status === "future";
          shape = el("g", { opacity: future ? 0.5 : 1 }, g);
          el("rect", { x: px0, y: mid - h / 2 - 2, width: w, height: h, rx: 3, fill: done ? tone[1] : tone[0],
            stroke: it.status === "active" ? tone[2] : "none", "stroke-width": 1.2 }, shape);
          var frac = it.points ? it.points_done / it.points : (done ? 1 : 0);
          if (frac > 0 && !done) el("rect", { x: px0, y: mid - h / 2 - 2, width: Math.round(w * frac), height: h, rx: 3, fill: tone[1] }, shape);
          if (w > 60 && it.kind === "epic") {
            var t = el("text", { x: px0 + 6, y: mid + 2, "font-size": 11, fill: "#1f2937" }, shape);
            t.textContent = it.title.length > w / 6.5 ? it.title.slice(0, Math.max(3, Math.floor(w / 6.5) - 1)) + "…" : it.title;
          }
        }
        hint(shape, about(it), it);
      }
      // The actual days, a thin bar beneath the plan.
      var a = actual(it);
      if (a && a.start) {
        var ax = x(a.start), aw = Math.max(xEnd(a.end || D.today) - ax, 2);
        var bar = el("rect", { x: ax, y: mid + 9, width: aw, height: 4, rx: 2, fill: "#475569" }, g);
        if (!a.end) bar.setAttribute("fill", "url(#open)");
        hint(bar, "<b>" + esc(it.title) + "</b><br>actual " + span(a) + (issuesOf[it.id] ? "<br>from " + issuesOf[it.id].length + " issues" : ""), it);
      }
      // An initiative's due dates.
      var lastDue = -1e9;
      (it.due || []).forEach(function (d) {
        var dx = xEnd(d.date) - px / 2;
        var dia = el("path", { d: "M" + dx + "," + (mid - 12) + " l7,7 l-7,7 l-7,-7 z", fill: tone[2], stroke: "#fff", "stroke-width": 1 }, g);
        // Labelled where it has room; the hover names it either way.
        if (dx - lastDue > 26) {
          el("text", { x: dx + 9, y: mid - 4, "font-size": 10, "font-weight": 600, fill: tone[2] }, g).textContent = d.group;
          lastDue = dx;
        }
        hint(dia, "<b>" + esc(it.title) + " " + esc(d.group) + "</b><br>due " + esc(d.date), it);
      });
      // The Sprint Goals serving the epic, as flags at their release.
      (flagsOf[it.id] || []).forEach(function (f, k) {
        var fx = xEnd(f.at) + 3 + 7 * k, c = GOAL[f.goal.status] || GOAL.future;
        var flag = el("g", {}, g);
        el("line", { x1: fx, y1: mid - 13, x2: fx, y2: mid + 8, stroke: c, "stroke-width": 1.5 }, flag);
        el("path", { d: "M" + fx + "," + (mid - 13) + " l9,4 l-9,4 z", fill: c }, flag);
        hint(flag, "<b>" + esc(f.goal.title) + "</b><br>" + esc(f.goal.id) + ", " + esc(f.goal.status) + "<br>selects " + (f.goal.selects || []).map(esc).join(", "), f.goal);
      });
    });
    // Dependencies. One that ends before its dependant starts is a grey
    // elbow from its end to the dependant's start; one that overlaps, which
    // a plan of overlapping horizons is full of, is an amber connector down
    // from its row into the dependant's start: the plan has the dependant
    // start before what it waits on ends.
    list.forEach(function (r) {
      var to = place[r.it.id];
      (r.it.depends_on || []).forEach(function (dep) {
        var from = place[dep];
        if (!from || !to) return;
        var d, c;
        if (from.x1 <= to.x0 - 4) {
          var mx = Math.min(to.x0 - 6, from.x1 + 10);
          d = "M" + from.x1 + "," + from.y + " H" + mx + " V" + to.y + " H" + (to.x0 - 1);
          c = 0;
        } else {
          var vx = to.x0 - 5;
          el("circle", { cx: vx, cy: from.y, r: 2.5, fill: "#d97706" }, arrows);
          d = "M" + vx + "," + from.y + " V" + to.y + " H" + (to.x0 - 1);
          c = 1;
        }
        var path = el("path", { d: d, fill: "none", stroke: c ? "#d97706" : "#94a3b8", "stroke-width": 1.2, "marker-end": "url(#arrow" + c + ")" }, arrows);
        hint(path, "<b>" + esc(r.it.title) + "</b><br>depends on " + esc((byId[dep] || {}).title || dep) + (c ? "<br>planned to start before it ends" : ""));
      });
    });
    var pat = el("pattern", { id: "open", width: 6, height: 4, patternUnits: "userSpaceOnUse" }, defs);
    el("rect", { width: 6, height: 4, fill: "#94a3b8" }, pat);
    el("rect", { width: 3, height: 4, fill: "#475569" }, pat);
    drawTree(list);
    // Embedded, the chart tells the page holding it how tall it is, so the
    // page sizes its frame to fit and the reader scrolls once, with the
    // page, rather than inside a frame that carries the controls and the
    // dates out of view (GH-136).
    if (window.parent !== window) {
      window.parent.postMessage({ timelineHeight: document.documentElement.scrollHeight }, "*");
    }
    // Keep the reader in place after a fold; else bring today, or the
    // road map's start, into view.
    if (keep) { plot.scrollLeft = left; window.scrollTo(0, top); }
    else plot.scrollLeft = state.view === "roadmap" ? 0 : Math.max(0, tx - plot.clientWidth / 3);
  }

  function drawTree(list) {
    var tree = document.getElementById("tree");
    tree.innerHTML = "";
    var head = document.createElement("div");
    head.className = "head";
    head.style.height = HEAD + "px";
    head.textContent = "Plan";
    tree.appendChild(head);
    list.forEach(function (r) {
      var it = r.it, row = document.createElement("div");
      row.className = "row";
      row.style.height = ROW + "px";
      row.style.paddingLeft = (4 + 14 * r.depth) + "px";
      var tw = document.createElement("span");
      tw.className = "tw";
      if (r.hasKids) {
        tw.textContent = isOpen(it) ? "▾" : "▸";
        tw.title = isOpen(it) ? "Fold" : "Expand";
        tw.addEventListener("click", function () { state.opened[state.view][it.id] = !isOpen(it); draw(true); });
      }
      var chip = document.createElement("span");
      chip.className = "chip";
      chip.style.background = (TONE[it.kind] || TONE.epic)[1];
      var name = document.createElement("span");
      name.className = "name";
      name.textContent = it.title;
      name.title = it.id + " " + it.title;
      name.addEventListener("click", function () { go(it); });
      var kind = document.createElement("span");
      kind.className = "kind";
      kind.textContent = it.kind;
      row.appendChild(tw); row.appendChild(chip); row.appendChild(name); row.appendChild(kind);
      tree.appendChild(row);
    });
  }

  // The legend names every shape.
  (function legend() {
    var box = document.getElementById("legend");
    function item(svg, label) {
      var s = document.createElement("span");
      s.innerHTML = '<svg width="22" height="12" viewBox="0 0 22 12">' + svg + "</svg>" + label;
      box.appendChild(s);
    }
    PLAN.forEach(function (k) { item('<rect x="1" y="2" width="20" height="8" rx="2" fill="' + TONE[k][1] + '"/>', k); });
    item('<path d="M11,0 l6,6 l-6,6 l-6,-6 z" fill="#1d4ed8"/>', "due date");
    item('<line x1="11" y1="0" x2="11" y2="12" stroke="#16a34a" stroke-width="2"/>', "release");
    item('<line x1="9" y1="1" x2="9" y2="12" stroke="#d97706" stroke-width="1.5"/><path d="M9,1 l8,3 l-8,3 z" fill="#d97706"/>', "Sprint Goal");
    item('<path d="M1,3 H8 V9 H19" fill="none" stroke="#94a3b8" stroke-width="1.5"/><path d="M17,6 L21,9 L17,12 z" fill="#94a3b8"/>', "depends on");
    item('<circle cx="4" cy="3" r="2.5" fill="#d97706"/><path d="M4,3 V9 H19" fill="none" stroke="#d97706" stroke-width="1.5"/><path d="M17,6 L21,9 L17,12 z" fill="#d97706"/>', "starts before it ends");
    item('<rect x="1" y="5" width="20" height="3" rx="1.5" fill="#475569"/>', "actual");
    item('<rect x="1" y="2" width="20" height="8" rx="2" fill="none" stroke="#94a3b8" stroke-dasharray="3 2"/>', "as planned at a tag");
    item('<line x1="11" y1="0" x2="11" y2="12" stroke="#dc2626" stroke-width="1.5"/>', "today");
  })();

  var select = document.getElementById("plan");
  D.plans.forEach(function (p, i) {
    var o = document.createElement("option");
    o.value = i; o.textContent = p.label;
    select.appendChild(o);
  });
  if (!D.plans.length) select.parentElement.hidden = true;
  function mark(group, attr, value) {
    document.querySelectorAll("#" + group + " button").forEach(function (b) { b.classList.toggle("on", b.getAttribute(attr) === value); });
  }
  function refresh() { mark("views", "data-view", state.view); mark("zoom", "data-mode", state.mode); draw(false); }
  document.querySelectorAll("#views button").forEach(function (b) {
    b.addEventListener("click", function () { state.view = b.getAttribute("data-view"); state.mode = state.view === "roadmap" ? "Quarter" : "Sprint"; refresh(); });
  });
  document.querySelectorAll("#zoom button").forEach(function (b) {
    b.addEventListener("click", function () { state.mode = b.getAttribute("data-mode"); refresh(); });
  });
  select.addEventListener("change", function (e) { state.ghost = Number(e.target.value); draw(true); });
  refresh();
})();
</script>
</body>
</html>
